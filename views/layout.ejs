<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Briefly — AI Industry Intelligence</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=Figtree:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body>
  <%- include('partials/nav') %>
  <%- include('partials/hero') %>
  <%- include('partials/how') %>
  <%- include('partials/sample-briefing') %>
  <%- include('partials/features') %>
  <%- include('partials/pricing') %>
  <%- include('partials/social-proof') %>
  <%- include('partials/insights') %>
  <%- include('partials/manifesto') %>
  <%- include('partials/closing') %>
  <%- include('partials/footer') %>
<script>
  (function() {
    function animateCount(el, target) {
      var start = 0;
      var duration = 1200;
      var startTime = null;
      function step(timestamp) {
        if (!startTime) startTime = timestamp;
        var progress = Math.min((timestamp - startTime) / duration, 1);
        var ease = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.floor(ease * target).toLocaleString();
        if (progress < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    function loadStats() {
      var subEl = document.getElementById('stat-subscribers');
      var paidEl = document.getElementById('stat-paid');
      if (!subEl || !paidEl) return;
      fetch('/api/stats')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          animateCount(subEl, data.totalSubscribers);
          animateCount(paidEl, data.activePaid);
        })
        .catch(function() {
          subEl.textContent = '—';
          paidEl.textContent = '—';
        });
    }

    var statsSection = document.querySelector('.sp-counters');
    if (statsSection) {
      var statsObserver = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting) {
          loadStats();
          statsObserver.disconnect();
        }
      }, { threshold: 0.3 });
      statsObserver.observe(statsSection);
    }
  })();

  (function() {
    // Store referral code from URL param into localStorage
    var urlParams = new URLSearchParams(window.location.search);
    var refCode = urlParams.get('ref');
    if (refCode) {
      localStorage.setItem('briefly_ref', refCode.toUpperCase());
      // Clean the URL without reloading
      window.history.replaceState({}, '', window.location.pathname);
    }

    function getBaseUrl() {
      return window.location.protocol + '//' + window.location.host;
    }

    function showSuccessState(successEl, email, referralCode) {
      successEl.innerHTML =
        '<span class="signup-check">✓</span>' +
        '<span>You\'re on the list — first briefing hits tomorrow morning.' +
        ' <a href="/onboard?email=' + encodeURIComponent(email) + '" style="color:#F5A623;font-weight:600;">Personalize your briefing →</a>' +
        (referralCode
          ? '<br><span style="font-size:0.8rem;opacity:0.7;margin-top:8px;display:block;">Your referral link: <strong>' + getBaseUrl() + '/ref/' + referralCode + '</strong></span>'
          : '') +
        '</span>';
      successEl.style.display = 'flex';
      successEl.style.flexDirection = 'column';
      successEl.style.gap = '4px';
    }

    function setupSignupForm(formId, successId) {
      var form = document.getElementById(formId);
      var success = document.getElementById(successId);
      if (!form) return;
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var email = form.querySelector('input[name="email"]').value.trim();
        var btn = form.querySelector('button');
        var ref = localStorage.getItem('briefly_ref') || null;
        btn.disabled = true;
        btn.textContent = 'Subscribing…';
        fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, ref: ref })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.ok) {
            form.style.display = 'none';
            showSuccessState(success, email, data.referralCode);
            localStorage.removeItem('briefly_ref');
          } else {
            btn.disabled = false;
            btn.textContent = 'Start free trial';
            alert(data.error || 'Something went wrong. Please try again.');
          }
        })
        .catch(function() {
          btn.disabled = false;
          btn.textContent = 'Start free trial';
          alert('Network error. Please try again.');
        });
      });
    }
    setupSignupForm('hero-signup', 'hero-success');
    setupSignupForm('closing-signup', 'closing-success');
  })();
</script>
<script>
  (function() {
    var els = document.querySelectorAll('.scroll-reveal');
    if (!els.length) return;
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    els.forEach(function(el) { io.observe(el); });
  })();
</script>
</body>
</html>