<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= briefing ? `Briefly — ${briefing.date_str}` : 'Briefly — Today\'s Briefing' %></title>
  <meta name="description" content="Today's AI & tech briefing from Briefly — the most important stories, synthesized.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=Figtree:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body class="today-body">

  <nav class="nav">
    <div class="nav-logo">Briefly</div>
    <div class="nav-tagline">AI industry intelligence</div>
    <a class="nav-cta" href="/">Get it in your inbox</a>
  </nav>

  <div class="today-wrap">
    <% if (briefing) { %>
      <div class="today-header">
        <div class="today-eyebrow">Daily briefing</div>
        <h1 class="today-headline"><%= briefing.date_str %></h1>
        <p class="today-meta"><%= briefing.story_count %> stories · <%= briefing.article_count %> sources scanned</p>
      </div>

      <div class="today-stories">
        <% const stories = Array.isArray(briefing.stories) ? briefing.stories : []; %>
        <% stories.forEach(function(story) { %>
          <div class="today-story">
            <div class="today-tag today-tag--<%= story.type || 'news' %>">
              <%= story.type === 'alert' ? '🔴 Alert' : story.type === 'signal' ? '🟡 Signal' : story.type === 'low' ? '⚪ Low' : '🟢 News' %>
            </div>
            <h2 class="today-story-title"><%= story.title %></h2>
            <p class="today-story-summary"><%= story.summary %></p>
            <% if (story.angle) { %>
              <p class="today-story-angle"><%= story.angle %></p>
            <% } %>
            <% if (story.url) { %>
              <a class="today-story-link" href="<%= story.url %>" target="_blank" rel="noopener">Read source →</a>
            <% } %>
          </div>
        <% }); %>
      </div>

    <% } else { %>
      <div class="today-empty">
        <div class="today-empty-icon">📰</div>
        <h2>Today's briefing is being prepared</h2>
        <p>Your agent is scanning 200+ sources right now. Subscribe to get it in your inbox the moment it's ready.</p>
      </div>
    <% } %>

    <div class="today-cta">
      <h3>Get this briefing every morning</h3>
      <p>Free to start. No credit card required.</p>
      <form class="signup-form signup-form--dark" id="today-signup">
        <input class="signup-input" type="email" name="email" placeholder="your@email.com" required autocomplete="email">
        <button class="signup-btn" type="submit">Subscribe free</button>
      </form>
      <div class="signup-success signup-success--dark" id="today-success" style="display:none;">
        <span class="signup-check">✓</span> You're in — first briefing tomorrow morning.
      </div>
    </div>
  </div>

  <footer class="footer">
    <div class="footer-brand">Briefly</div>
    <div class="footer-copy">AI-powered industry intelligence.</div>
    <div class="footer-links">
      <a href="/" style="color:inherit;">← Back to home</a>
    </div>
  </footer>

  <script>
    (function() {
      var form = document.getElementById('today-signup');
      var success = document.getElementById('today-success');
      if (!form) return;
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var email = form.querySelector('input[name="email"]').value.trim();
        var btn = form.querySelector('button');
        btn.disabled = true;
        btn.textContent = 'Subscribing…';
        fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.ok) {
            form.style.display = 'none';
            success.style.display = 'flex';
          } else {
            btn.disabled = false;
            btn.textContent = 'Subscribe free';
            alert(data.error || 'Something went wrong.');
          }
        })
        .catch(function() {
          btn.disabled = false;
          btn.textContent = 'Subscribe free';
        });
      });
    })();
  </script>
</body>
</html>
